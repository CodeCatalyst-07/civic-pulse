NODE_ENV=development
REPOSITORY_MODE=local

GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=
# Runtime mode is reported by GET /health: live when all three variables above
# are configured with Application Default Credentials; otherwise mock.

FIRESTORE_DATABASE=(default)
BIGQUERY_DATASET=civicpulse_analytics

MAPS_SERVER_KEY=
NEXT_PUBLIC_MAPS_BROWSER_KEY=
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

DEMO_MODE=true
